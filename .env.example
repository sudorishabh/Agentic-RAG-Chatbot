# Standard chat model (e.g. gpt-5-mini)
AZURE_OPENAI_MODEL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-06-01

# Temperature for structured/deterministic LLM calls (query understanding,
# routing, rerank, faithfulness). Leave unset for reasoning models (gpt-5 /
# o-series) — they reject any value but the default. Set 0 for classic chat models.
# LLM_STRUCTURED_TEMPERATURE=0

# Embeddings model (e.g. text-embedding-3-large)
AZURE_OPENAI_EMBEDDING_MODEL=
AZURE_OPENAI_EMBEDDING_KEY=
AZURE_OPENAI_EMBEDDING_ENDPOINT=
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-06-01
# Output vector size. text-embedding-3-{small,large} support truncation; 1536
# halves storage/search cost vs 3-large's native 3072. Leave blank for ada-002.
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536

# PDF extraction. EXTRACTION_MODE: hybrid (per-page routing, default) |
# azure_only | local_only. Azure Document Intelligence OCRs scanned pages:
# "prebuilt-read" = OCR only (cheap); "prebuilt-layout" ~6x cost, also tables.
EXTRACTION_MODE=hybrid
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-read
PDF_SCANNED_CHAR_THRESHOLD=100
CAMELOT_FLAVOR=lattice

# PDF sources scanned by the ingestion sweep / /ingest/pdfs.
PDF_SOURCE_PATH=
# PDF_SOURCE_DIRS=
# PDF_IGNORE_GLOBS=

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents
RETRIEVAL_CANDIDATE_K=40
RETRIEVAL_TOP_K=6

# MySQL — ingest-state manifest / document catalog (structured-query path).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_POOL_SIZE=5

# Redis (optional) — response + embedding caches; empty disables them.
# The semantic cache lives in Qdrant (SEMANTIC_CACHE_COLLECTION=semantic_cache).
REDIS_URL=

# Background sweep on the ingestion server (seconds; 0 disables).
WORKER_SWEEP_INTERVAL_SECONDS=3600

# --- Public retrieval API -------------------------------------------------
# Bearer-JWT auth on /chat, /search, /source. Off = anonymous (default/public).
AUTH_ENABLED=false
JWT_SECRET=
JWT_ALGORITHMS=HS256
# JWT_AUDIENCE=
# JWT_ISSUER=
# JWT_TENANT_CLAIM=tenant_id
# JWT_GROUPS_CLAIM=groups

# Pin the embedding host site(s) in production (comma-separated; * warns at startup).
CORS_ALLOW_ORIGINS=*
# Expose infra detail on /ready and /metrics (keep off on the public server).
OPS_DETAIL_ENABLED=false
# JWT group allowed to read /metrics and /metrics/timings even when
# OPS_DETAIL_ENABLED is off (requires AUTH_ENABLED=true).
# OPS_ADMIN_GROUP=admin
# Absolute API base for citation links when the frontend runs on another origin.
# SOURCE_BASE_URL=

# --- Drupal source ---------------------------------------------------------
# DRUPAL_JSONAPI_BASE=https://teriin.org/jsonapi
# DRUPAL_INGEST_EXTERNAL_PDFS=false
