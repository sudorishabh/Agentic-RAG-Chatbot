# Standard chat model (e.g. gpt-5-mini)
AZURE_OPENAI_MODEL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-06-01

# Reasoning chat model (e.g. gpt-5)
AZURE_OPENAI_REASONING_MODEL=
AZURE_OPENAI_REASONING_API_KEY=
AZURE_OPENAI_REASONING_ENDPOINT=
AZURE_OPENAI_REASONING_API_VERSION=2024-06-01

# Embeddings model (e.g. text-embedding-3-large)
AZURE_OPENAI_EMBEDDING_MODEL=
AZURE_OPENAI_EMBEDDING_KEY=
AZURE_OPENAI_EMBEDDING_ENDPOINT=
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-06-01

# PDF extraction — Azure Document Intelligence (OCR/layout for scanned PDFs)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-layout

# PDF extraction — Docling (digital PDFs) + figures
PDF_SCANNED_CHAR_THRESHOLD=100
PDF_OCR_RENDER_DPI=300
DOCLING_TABLE_MODE=accurate
DOCLING_ARTIFACTS_PATH=
PDF_EXTRACT_IMAGES=true
PDF_IMAGE_DIR=data/extracted_images
PDF_IMAGE_MIN_PIXELS=64
PDF_DESCRIBE_IMAGES=true
PDF_IMAGE_CAPTION_MAX_TOKENS=256

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=4

# MYSQL / MARIADB
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
